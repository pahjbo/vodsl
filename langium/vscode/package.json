{
  "name": "vodsl",
  "displayName": "VODSL",
  "description": "VODSL language support and VO-DML compilation",
  "version": "0.1.0",
  "publisher": "tsastro",
  "private": true,
  "preview": true,
  "license": "AGPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/pahjbo/vodsl.git" },
  "bugs": { "url": "https://github.com/pahjbo/vodsl/issues" },
  "categories": ["Programming Languages"],
  "keywords": ["vodsl", "vo-dml", "astronomy", "data modeling"],
  "type": "module",
  "engines": { "vscode": "^1.146.0" },
  "main": "./dist/extension.cjs",
  "files": [
    "dist/**",
    "language-configuration.json",
    "vodsl.tmLanguage.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "activationEvents": ["onLanguage:vodsl"],
  "contributes": {
    "languages": [{
      "id": "vodsl",
      "aliases": ["VODSL", "vodsl"],
      "extensions": [".vodsl"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "vodsl",
      "scopeName": "source.vodsl",
      "path": "./vodsl.tmLanguage.json"
    }],
    "commands": [{
      "command": "vodsl.compile",
      "title": "VODSL: Compile to VO-DML"
    }],
    "configuration": {
      "title": "VODSL",
      "properties": {
        "vodsl.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a supported Node.js executable. Leave empty to use VS Code's embedded runtime; restart VS Code after changing it."
        }
      }
    }
  }
}
