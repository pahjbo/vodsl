{
  "name": "vodsl-langium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vodsl": "./out/cli.js"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "generate": "langium generate",
    "build": "npm run generate && tsc && npm run bundle",
    "bundle": "node build.mjs",
    "test": "npm run build && node --test out/test/*.test.js",
    "package:vsix": "npm run build && cd vscode && ../node_modules/.bin/vsce package --no-dependencies -o ../vodsl.vsix",
    "test:vsix": "node scripts/test-vsix.mjs"
  },
  "dependencies": {
    "elkjs": "0.8.2",
    "inversify": "6.0.2",
    "langium": "~4.4.0",
    "reflect-metadata": "0.2.2",
    "sprotty": "1.1.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "~10.1.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "langium-cli": "~4.4.0",
    "playwright-core": "1.56.1",
    "typescript": "~5.9.0",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
